# Lombok configuration for the whole repository - .claude/rules/java-lombok.md is the rule, and
# this file is the part of it the COMPILER enforces. Every flagUsage below is a compile error:
# Lombok reports it through javac, and the build compiles with -Werror.
#
# Declared as an input of every JavaCompile task (finapp.java-conventions), so an edit here
# recompiles what it affects instead of leaving stale classes behind.

# This is the root. Nothing above the repository may change how its code is generated.
config.stopBubbling = true

# Generated members carry @lombok.Generated (CLASS retention), so bytecode tools - coverage,
# ArchUnit - can tell code Lombok wrote from code a person wrote.
lombok.addLombokGeneratedAnnotation = true

# No java.beans.ConstructorProperties on generated constructors: nothing here is a JavaBean.
lombok.anyConstructor.addConstructorProperties = false

# @NonNull throws exactly what Objects.requireNonNull throws, so a constructor converted from
# requireNonNull checks keeps its fail-fast contract - the same exception, at the same moment.
lombok.nonNull.exceptionType = NullPointerException

# A generated toString shows NO field unless that field is marked @ToString.Include. Safe by
# default: a toString that prints every field is how a secret, a PAN or a customer's name reaches
# a log line (security.md). Including a field is a decision somebody makes and review can see.
lombok.toString.onlyExplicitlyIncluded = true

# @EqualsAndHashCode on a subclass must say whether the superclass takes part - silence is a
# compile error, because the default (ignore the superclass) is the unsafe equality nobody chose.
lombok.equalsAndHashCode.callSuper = warn

# The logger @Slf4j generates: private static final org.slf4j.Logger log.
lombok.log.fieldName = log

# ---------------------------------------------------------------------------
# BANNED - each is a compile error, with the reason beside it.
# ---------------------------------------------------------------------------

# @Data bundles setters, all-field equality and an all-field toString into one annotation: the
# three decisions a financial or PII-bearing class must make separately.
lombok.data.flagUsage = error

# Hides checked exceptions from the signature - failure handling that nobody can see.
lombok.sneakyThrows.flagUsage = error

# A JVM-local lock. Correctness never rests on one process (CLAUDE.md), and the platform's own
# rule already refuses synchronized blocks and methods (NoSingleInstanceAssumptionRulesTest).
lombok.synchronized.flagUsage = error

# Java has var and try-with-resources; the Lombok spellings are a second way to say each.
lombok.val.flagUsage = error
lombok.var.flagUsage = error
lombok.cleanup.flagUsage = error

# Experimental features (@Accessors, @UtilityClass, @Delegate, @SuperBuilder, @Jacksonized, ...)
# and the onX syntax: their behaviour may change between Lombok releases.
lombok.experimental.flagUsage = error
lombok.onX.flagUsage = error

# One logging facade: SLF4J, through @Slf4j. Every other Lombok logger is refused.
lombok.log.javaUtilLogging.flagUsage = error
lombok.log.apacheCommons.flagUsage = error
lombok.log.log4j.flagUsage = error
lombok.log.log4j2.flagUsage = error
lombok.log.jbosslog.flagUsage = error
lombok.log.flogger.flagUsage = error
lombok.log.xslf4j.flagUsage = error
lombok.log.custom.flagUsage = error
