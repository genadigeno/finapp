{
  "components": {
    "headers": {
      "X-Correlation-Id": {
        "description": "The identifier of this request flow. Quote it when reporting a problem; it is what joins a client report to the record of what happened.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "api.Conflict": {
        "content": {
          "application/problem+json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ProblemDetail"
                },
                {
                  "properties": {
                    "code": {
                      "const": "api.Conflict"
                    },
                    "status": {
                      "const": 409
                    },
                    "type": {
                      "const": "https://finapp.example/problems/api.Conflict"
                    }
                  }
                }
              ]
            }
          }
        },
        "description": "[409] The request conflicts with the current state.",
        "headers": {
          "X-Correlation-Id": {
            "$ref": "#/components/headers/X-Correlation-Id"
          }
        }
      },
      "api.Forbidden": {
        "content": {
          "application/problem+json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ProblemDetail"
                },
                {
                  "properties": {
                    "code": {
                      "const": "api.Forbidden"
                    },
                    "status": {
                      "const": 403
                    },
                    "type": {
                      "const": "https://finapp.example/problems/api.Forbidden"
                    }
                  }
                }
              ]
            }
          }
        },
        "description": "[403] You do not have permission to do that.",
        "headers": {
          "X-Correlation-Id": {
            "$ref": "#/components/headers/X-Correlation-Id"
          }
        }
      },
      "api.InternalError": {
        "content": {
          "application/problem+json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ProblemDetail"
                },
                {
                  "properties": {
                    "code": {
                      "const": "api.InternalError"
                    },
                    "status": {
                      "const": 500
                    },
                    "type": {
                      "const": "https://finapp.example/problems/api.InternalError"
                    }
                  }
                }
              ]
            }
          }
        },
        "description": "[500] Something went wrong on our side.",
        "headers": {
          "X-Correlation-Id": {
            "$ref": "#/components/headers/X-Correlation-Id"
          }
        }
      },
      "api.MalformedRequest": {
        "content": {
          "application/problem+json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ProblemDetail"
