        "description": "[409] The request conflicts with the current state.",
        "headers": {
          "X-Client-Correlation-Id": {
            "$ref": "#/components/headers/X-Client-Correlation-Id"
          },
          "X-Correlation-Id": {
            "$ref": "#/components/headers/X-Correlation-Id"
