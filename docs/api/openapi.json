                    "type": {
                      "const": "https://finapp.example/problems/api.NotFound"
                    }
                  }
                }
              ]
            }
          }
        },
        "description": "[404] The requested resource does not exist.",
        "headers": {
          "X-Correlation-Id": {
            "$ref": "#/components/headers/X-Correlation-Id"
          }
        }
      },
      "api.PayloadTooLarge": {
        "content": {
          "application/problem+json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ProblemDetail"
                },
                {
                  "properties": {
                    "code": {
                      "const": "api.PayloadTooLarge"
                    },
                    "status": {
                      "const": 413
                    },
                    "type": {
                      "const": "https://finapp.example/problems/api.PayloadTooLarge"
                    }
                  }
                }
              ]
            }
          }
        },
        "description": "[413] The request was too large.",
        "headers": {
          "X-Correlation-Id": {
            "$ref": "#/components/headers/X-Correlation-Id"
          }
        }
