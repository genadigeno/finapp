                {
                  "properties": {
                    "code": {
                      "const": "api.MalformedRequest"
                    },
                    "status": {
                      "const": 400
                    },
                    "type": {
                      "const": "https://finapp.example/problems/api.MalformedRequest"
                    }
                  }
                }
              ]
            }
          }
        },
        "description": "[400] The request could not be understood.",
        "headers": {
          "X-Correlation-Id": {
            "$ref": "#/components/headers/X-Correlation-Id"
          }
        }
      },
      "api.MethodNotAllowed": {
        "content": {
          "application/problem+json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ProblemDetail"
                },
                {
                  "properties": {
                    "code": {
                      "const": "api.MethodNotAllowed"
                    },
                    "status": {
                      "const": 405
                    },
                    "type": {
                      "const": "https://finapp.example/problems/api.MethodNotAllowed"
                    }
                  }
                }
              ]
            }
          }
        },
        "description": "[405] That method is not allowed here.",
        "headers": {
          "X-Correlation-Id": {
            "$ref": "#/components/headers/X-Correlation-Id"
          }
        }
      },
      "api.NotAcceptable": {
        "content": {
          "application/problem+json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ProblemDetail"
                },
                {
                  "properties": {
                    "code": {
                      "const": "api.NotAcceptable"
                    },
                    "status": {
                      "const": 406
                    },
                    "type": {
                      "const": "https://finapp.example/problems/api.NotAcceptable"
                    }
                  }
                }
              ]
            }
          }
        },
        "description": "[406] No acceptable representation is available.",
        "headers": {
          "X-Correlation-Id": {
            "$ref": "#/components/headers/X-Correlation-Id"
          }
        }
      },
      "api.NotFound": {
        "content": {
          "application/problem+json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ProblemDetail"
                },
                {
                  "properties": {
                    "code": {
                      "const": "api.NotFound"
                    },
                    "status": {
                      "const": 404
