      "api.Unauthenticated": {
        "content": {
          "application/problem+json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ProblemDetail"
                },
                {
                  "properties": {
                    "code": {
                      "const": "api.Unauthenticated"
                    },
                    "status": {
                      "const": 401
                    },
                    "type": {
                      "const": "https://finapp.example/problems/api.Unauthenticated"
                    }
                  }
                }
              ]
            }
          }
        },
        "description": "[401] Authentication is required.",
        "headers": {
          "X-Correlation-Id": {
            "$ref": "#/components/headers/X-Correlation-Id"
          }
        }
      },
      "api.UnsupportedMediaType": {
        "content": {
          "application/problem+json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ProblemDetail"
                },
                {
                  "properties": {
                    "code": {
                      "const": "api.UnsupportedMediaType"
                    },
                    "status": {
                      "const": 415
                    },
                    "type": {
                      "const": "https://finapp.example/problems/api.UnsupportedMediaType"
                    }
                  }
                }
              ]
            }
          }
        },
        "description": "[415] That media type is not supported.",
        "headers": {
          "X-Correlation-Id": {
            "$ref": "#/components/headers/X-Correlation-Id"
          }
        }
      },
      "api.ValidationFailed": {
        "content": {
          "application/problem+json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ProblemDetail"
                },
                {
                  "properties": {
                    "code": {
                      "const": "api.ValidationFailed"
                    },
                    "status": {
                      "const": 422
                    },
                    "type": {
                      "const": "https://finapp.example/problems/api.ValidationFailed"
                    }
                  }
                }
              ]
            }
          }
        },
        "description": "[422] The request was not valid.",
        "headers": {
          "X-Correlation-Id": {
            "$ref": "#/components/headers/X-Correlation-Id"
          }
        }
      }
    },
    "schemas": {
      "ProblemDetail": {
        "description": "An RFC 9457 problem detail. Clients switch on `code`; `title` is prose and may be reworded, and several codes share a status. Absent members are absent, never null.",
        "properties": {
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "status": {
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The public HTTP contract. Versioned in the path (ADR-0015); errors follow RFC 9457, catalogued in docs/architecture/ERROR_CONTRACT.md. Generated from the application on every build and compared against this committed copy, so a change to the contract cannot reach a client without being reviewed.",
    "title": "finapp platform API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": { }
}
