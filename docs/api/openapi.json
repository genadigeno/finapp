    "schemas": {
      "AuthenticationRequest": {
        "properties": {
          "loginIdentifier": {
            "maxLength": 64,
            "minLength": 3,
            "pattern": "[A-Za-z0-9._-]+",
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "loginIdentifier",
          "password"
        ],
        "type": "object"
      },
      "ContactChannelRequest": {
        "properties": {
          "address": {
            "type": "string"
          }
        },
        "required": [
          "address"
        ],
        "type": "object"
      },
      "ContactChannelVerificationRequest": {
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "ElevatedSession": {
        "properties": {
          "assurance": {
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "sessionToken": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "MfaConfirmationRequest": {
        "properties": {
          "code": {
            "maxLength": 8,
            "minLength": 6,
            "pattern": "[0-9]+",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "MfaEnrolmentStarted": {
        "properties": {
          "digits": {
            "format": "int32",
            "type": "integer"
          },
          "periodSeconds": {
            "format": "int32",
            "type": "integer"
          },
          "provisioningUri": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ProblemDetail": {
        "description": "An RFC 9457 problem detail. Clients switch on `code`; `title` is prose and may be reworded, and several codes share a status. Absent members are absent, never null.",
        "properties": {
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "status": {
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "type": "object"
      },
      "RecoveryCompletionRequest": {
        "properties": {
          "password": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "password",
          "token"
        ],
        "type": "object"
      },
      "RecoveryInitiationRequest": {
        "properties": {
          "loginIdentifier": {
            "maxLength": 64,
            "minLength": 3,
            "pattern": "[A-Za-z0-9._-]+",
            "type": "string"
          }
        },
        "required": [
          "loginIdentifier"
        ],
        "type": "object"
      },
      "RegistrationRequest": {
        "properties": {
          "displayName": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Co}\\p{Cn}]+",
            "type": "string"
          },
          "loginIdentifier": {
            "maxLength": 64,
            "minLength": 3,
            "pattern": "[A-Za-z0-9._-]+",
            "type": "string"
          }
        },
        "required": [
          "displayName",
          "loginIdentifier"
        ],
        "type": "object"
      },
      "SessionSummary": {
        "properties": {
          "absoluteExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "assurance": {
            "type": "string"
          },
          "current": {
            "type": "boolean"
          },
          "device": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "idleExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "issuedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The public HTTP contract. Versioned in the path (ADR-0015); errors follow RFC 9457, catalogued in docs/architecture/ERROR_CONTRACT.md. Generated from the application on every build and compared against this committed copy, so a change to the contract cannot reach a client without being reviewed.",
    "title": "finapp platform API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/authentications": {
      "post": {
        "operationId": "authenticate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthenticationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/v1/authentications/mfa": {
      "post": {
        "operationId": "elevateAssurance",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaConfirmationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ElevatedSession"
                }
              }
            },
            "description": "OK"
          }
        }
      }
    },
    "/v1/me/channels": {
      "post": {
        "operationId": "addChannel",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactChannelRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted"
          }
        }
      }
    },
    "/v1/me/channels/verification": {
      "post": {
        "operationId": "verifyChannel",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactChannelVerificationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/v1/me/mfa": {
      "post": {
        "operationId": "beginMfaEnrolment",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MfaEnrolmentStarted"
                }
              }
            },
            "description": "Created"
          }
        }
      }
    },
    "/v1/me/mfa/confirmation": {
      "post": {
        "operationId": "confirmMfaEnrolment",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaConfirmationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/v1/recoveries": {
      "post": {
        "operationId": "initiateRecovery",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecoveryInitiationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted"
          }
        }
      }
    },
    "/v1/recoveries/{id}/completion": {
      "post": {
        "operationId": "completeRecovery",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecoveryCompletionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/v1/registrations": {
      "post": {
        "operationId": "register",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/v1/sessions": {
      "get": {
        "operationId": "listSessions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionSummary"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        }
      }
    },
    "/v1/sessions/current": {
      "delete": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/v1/sessions/{id}": {
      "delete": {
        "operationId": "revokeSession",
