{
  "components": {
    "headers": {
      "X-Client-Correlation-Id": {
        "description": "The value supplied in the request's X-Correlation-Id header, returned unchanged. It is never adopted as the flow's identifier (ADR-0034) and reaches no log, span or stored record; it exists so a caller that no longer holds the connection can match a response to a request. Present only when a well-formed value was supplied.",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "X-Correlation-Id": {
        "description": "The identifier of this request flow. Quote it when reporting a problem; it is what joins a client report to the record of what happened.",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
