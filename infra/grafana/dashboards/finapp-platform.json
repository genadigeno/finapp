{
  "uid": "finapp-platform",
  "title": "finapp — platform baseline",
  "description": "The Phase 0 operational picture: is the instance up, is the outbox draining, and is the connection pool the bottleneck. Provisioned from git (P0-TSK-029); edit the file, not the UI.",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "utc",
  "panels": [
    {
      "type": "row",
      "title": "Outbox — publication lag",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Pending events",
      "description": "Unpublished outbox events, dead-lettered ones included. Depth alone is ambiguous — a thousand published within the second is healthy — so read it beside the age panel.",
      "datasource": { "type": "prometheus", "uid": "finapp-prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "finapp_outbox_pending", "legendFormat": "pending" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "Oldest unpublished",
      "description": "How long the oldest unpublished event has waited. This is what separates 'busy' from 'stuck': a growing age with a flat depth means the relay is not draining.",
      "datasource": { "type": "prometheus", "uid": "finapp-prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "finapp_outbox_oldest_seconds", "legendFormat": "oldest" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "timeseries",
      "title": "Outbox backlog over time",
      "description": "Depth and age together. Absent data — not zero — is what a gauge reports when the database cannot be read, so a gap here is an outage rather than an empty outbox.",
      "datasource": { "type": "prometheus", "uid": "finapp-prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "finapp_outbox_pending", "legendFormat": "pending events" },
        { "refId": "B", "expr": "finapp_outbox_oldest_seconds", "legendFormat": "oldest (s)" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "short",
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "type": "row",
      "title": "Request path",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "HTTP requests by outcome",
      "description": "Framework metrics, not ours — useful, and not a contract. A rise in 5xx here beside a flat 4xx is our fault; the reverse is a client's.",
      "datasource": { "type": "prometheus", "uid": "finapp-prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          },
          "unit": "reqps",
          "noValue": "no traffic"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "type": "timeseries",
      "title": "Connection pool",
      "description": "The failure ADR-0016 and the connection-pool debt both name: ten instances at Hikari's default exhaust PostgreSQL's default max_connections before doing any work. Pending threads rising while active is flat is waiting, not load.",
      "datasource": { "type": "prometheus", "uid": "finapp-prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "hikaricp_connections_active", "legendFormat": "active" },
        { "refId": "B", "expr": "hikaricp_connections_idle", "legendFormat": "idle" },
        { "refId": "C", "expr": "hikaricp_connections_pending", "legendFormat": "threads waiting" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "unit": "short",
          "decimals": 0,
          "noValue": "no data"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "threads waiting" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "type": "row",
      "title": "Identity — security signals",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Recovery initiations",
      "description": "THE account-takeover signal (PHASE_1_PLAN.md §10). A campaign is a rise here — and a rise in `refused` is a probe against identifiers that do not exist, which the 202 response deliberately hides from the caller and cannot hide from this.",
      "datasource": { "type": "prometheus", "uid": "finapp-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(finapp_identity_recovery_initiation_total[5m]))", "legendFormat": "{{outcome}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
          "unit": "reqps",
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "type": "timeseries",
      "title": "Authentication outcomes and lockouts",
      "description": "Failure rate is noisy and mostly benign; a spike in LOCKOUTS is credential stuffing. Two meters rather than a third tag value, so the second signal is not buried in the first's noise.",
      "datasource": { "type": "prometheus", "uid": "finapp-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(finapp_identity_authentication_total[5m]))", "legendFormat": "{{outcome}}" },
        { "refId": "B", "expr": "sum(rate(finapp_identity_lockout_total[5m]))", "legendFormat": "lockouts" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
          "unit": "reqps",
          "noValue": "no data"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "lockouts" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "type": "timeseries",
      "title": "Second-factor challenges",
      "description": "Refusals rising is somebody holding a stolen password and failing at the second factor. The REASON — wrong code, replayed, no factor — lives in the audit trail and never in a tag.",
      "datasource": { "type": "prometheus", "uid": "finapp-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(finapp_identity_mfa_challenge_total[5m]))", "legendFormat": "{{outcome}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
          "unit": "reqps",
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "type": "timeseries",
      "title": "Live sessions",
      "description": "max(), NEVER sum(): the gauge is read from the database, so every instance reports the same fleet-wide figure and summing ten replicas would report ten times the truth. Absent rather than zero when the database is unreadable — a comforting zero is not alertable.",
      "datasource": { "type": "prometheus", "uid": "finapp-prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 23 },
      "targets": [
        { "refId": "A", "expr": "max(finapp_identity_session_active)", "legendFormat": "live" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
          "unit": "short",
          "decimals": 0,
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "type": "timeseries",
      "title": "Session lifetime, when its owner ended it",
      "description": "ONE POPULATION, and it is not all sessions: expiry is derived and never observed (ADR-0030), so expired sessions cannot appear here. Bulk revocation and step-up rotation are excluded too. The MEAN rather than a quantile: a Timer publishes no histogram buckets without publishPercentileHistogram(), whose cardinality this low-volume signal does not earn, and client-side percentiles do not aggregate across replicas. DashboardQueriesResolveTest caught the first version querying _bucket.",
      "datasource": { "type": "prometheus", "uid": "finapp-prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 23 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(finapp_identity_session_lifetime_seconds_sum[30m])) / sum(rate(finapp_identity_session_lifetime_seconds_count[30m]))", "legendFormat": "mean" },
        { "refId": "B", "expr": "sum(rate(finapp_identity_session_lifetime_seconds_count[30m]))", "legendFormat": "samples/s" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
          "unit": "s",
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "type": "row",
      "title": "KYC and consent — verification flow",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Case throughput",
      "description": "finapp.kyc.case by outcome (PHASE_2_PLAN.md §10): opened at creation, approved/rejected at decision, counted at the store seam so every door - the endpoint, the consumer, KYB registration and both decision paths - moves it. The straight-through rate is derivable as approved over opened. Per-instance counters: aggregate with sum(rate(...)).",
      "datasource": { "type": "prometheus", "uid": "finapp-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 31 },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(finapp_kyc_case_total[5m]))", "legendFormat": "{{outcome}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
          "unit": "reqps",
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "type": "timeseries",
      "title": "Check outcomes",
      "description": "finapp.kyc.check as normalised by us, never a provider verdict (INV-KYC-01). A rising indeterminate is a provider degrading - which is exactly the moment this series must already exist, and why it is registered eagerly and unconditionally (P2-TSK-020).",
      "datasource": { "type": "prometheus", "uid": "finapp-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 31 },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(finapp_kyc_check_total[5m]))", "legendFormat": "{{outcome}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
          "unit": "reqps",
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "type": "timeseries",
      "title": "Review queue",
      "description": "Checks awaiting a person (PHASE_2_PLAN.md §10: the queue nobody watches is the queue that ages). A fleet-wide gauge read from the database, so every instance reports the same figure: max(), NEVER sum() - summing ten replicas reports ten times the truth.",
      "datasource": { "type": "prometheus", "uid": "finapp-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 31 },
      "targets": [
        { "refId": "A", "expr": "max(finapp_kyc_review_queue)", "legendFormat": "waiting" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
          "unit": "none",
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "type": "timeseries",
      "title": "Provider latency",
      "description": "Verification provider round-trip time, refusals included - the port is total, so a timeout or a 5xx is a timed result, never an exception (ADR-0008). The MEAN, for the session-lifetime panel's reason: a Timer publishes no histogram buckets without publishPercentileHistogram(), whose cardinality this signal does not earn.",
      "datasource": { "type": "prometheus", "uid": "finapp-prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 38 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(finapp_kyc_provider_latency_seconds_sum[5m])) / sum(rate(finapp_kyc_provider_latency_seconds_count[5m]))", "legendFormat": "mean" },
        { "refId": "B", "expr": "sum(rate(finapp_kyc_provider_latency_seconds_count[5m]))", "legendFormat": "calls/s" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
          "unit": "s",
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "type": "timeseries",
      "title": "Consent grants and withdrawals",
      "description": "finapp.consent.grant and finapp.consent.withdrawal by purpose (PHASE_2_PLAN.md §10): a withdrawal spike is a trust event worth seeing, which is why it is its own meter rather than an outcome tag buried in the grant rate. The purpose tag is bounded by the closed ConsentPurpose enum (MetricNames.ALLOWED_TAG_KEYS records the decision).",
      "datasource": { "type": "prometheus", "uid": "finapp-prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 38 },
      "targets": [
        { "refId": "A", "expr": "sum by (purpose) (rate(finapp_consent_grant_total[5m]))", "legendFormat": "{{purpose}} granted" },
        { "refId": "B", "expr": "sum by (purpose) (rate(finapp_consent_withdrawal_total[5m]))", "legendFormat": "{{purpose}} withdrawn" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
          "unit": "reqps",
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    }
  ]
}
